rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // 既存の izumi-menu のメニュー画像 (menu_images/*) もここで read public・write auth として運用される。
    // izumi-hp 側で新たに Storage を使う場合（商品画像など）も同じポリシーで運用。
    match /{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
