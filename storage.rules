rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // 管理者判定ヘルパー。Firestore 側と同じく `admin: true` Custom Claim を要求。
    function isAdmin() {
      return request.auth != null && request.auth.token.admin == true;
    }

    // izumi-menu のメニュー画像 (menu_images/*) — 公開閲覧、admin で書込
    match /menu_images/{file=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // izumi-hp 系の画像（読み物カバー、汎用アップロード等）
    // クライアントSDKからの書込は拒否、Admin SDK 経由のみ。
    // 読み取りは公開（公開記事に埋め込まれるため）。
    match /journal-covers/{file=**} {
      allow read: if true;
      allow write: if false;
    }
    match /product-images/{file=**} {
      allow read: if true;
      allow write: if false;
    }
    match /uploads/{file=**} {
      allow read: if true;
      allow write: if false;
    }

    // 既定: 拒否（明示しないパスは触れない）
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
