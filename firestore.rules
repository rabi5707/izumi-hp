rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // 管理者判定ヘルパー。
    // Firebase Auth のメール/パスワード自己サインアップが有効になっている場合、
    // `request.auth != null` だけだと「適当に登録した第三者」も書き込めてしまう。
    // そのため `admin: true` の Custom Claim を持つユーザーのみ許可する。
    // Claim 付与は Admin SDK で `auth.setCustomUserClaims(uid, { admin: true })`。
    function isAdmin() {
      return request.auth != null && request.auth.token.admin == true;
    }

    // ===== izumi-menu 系（QR閲覧 + admin編集） =====
    match /menus/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /banquet_menus/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /plans/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /events/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ===== izumi-hp 系（Admin SDK 経由のみ） =====
    // クライアントSDKからの直接アクセスは拒否。
    // サーバー側 (Next.js API route) は Admin SDK で rules をバイパスして書込。
    match /orders/{id} {
      allow read, write: if false;
    }
    match /inquiries/{id} {
      allow read, write: if false;
    }

    // 読み物（journal）。サーバー側 (Admin SDK) で読み取り→ ISR でキャッシュ
    // するため、クライアントからの直接アクセスは公開済みのみ許可。
    // 編集は Admin SDK 経由（`/admin/journal` UI）のみ。
    match /journal_posts/{slug} {
      allow read: if resource.data.published == true;
      allow write: if false;
    }

    // 商品（products / 冷凍折詰）。journal と同じく Admin SDK 経由のみ書込。
    match /products/{id} {
      allow read: if resource.data.published == true;
      allow write: if false;
    }

    // ===== その他は全拒否 =====
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
